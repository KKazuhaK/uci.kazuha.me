---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LangBoot from "../../../components/LangBoot.astro";
import LangSwitch from "../../../components/LangSwitch.astro";
import { formatLastModified, lastModified } from "../../../lib/git";
import { LANGS, otherLang, type Lang } from "../../../lib/i18n";
import { courseSlug, getCourses, getNoteGroups, unitLabel } from "../../../lib/notes";
import { getCourseTopics, type TopicEntry } from "../../../lib/topics";
import { noteUrl, url } from "../../../lib/urls";

export const getStaticPaths = (async () => {
  const groups = await getNoteGroups();
  return (await getCourses()).map((course) => ({
    params: { course: courseSlug(course.data.code) },
    props: { course, groups: groups.get(course.data.code) ?? [] },
  }));
}) satisfies GetStaticPaths;

const { course, groups } = Astro.props;
const c = course.data;
const unitWord = groups[0]?.unit === "lecture" ? "Lecture-by-lecture" : "Week-by-week";
// A topic that has its own topic note shows only that note (one unified note per topic); the lecture
// sections it was built from stay in the By lecture view. Topics without one list the lecture sections.
const topics =
  (await getCourseTopics(course, groups))
    ?.map((t) => (t.entries.some((e) => e.group.kind === "topic") ? { ...t, entries: t.entries.filter((e) => e.group.kind === "topic") } : t))
    .filter((t) => t.entries.length) ?? null;
const byWeek = groups[0]?.unit === "week";
const unitGroups = groups.filter((g) => g.kind === "unit");
const reviewGroups = groups.filter((g) => g.kind === "review");
// Views offered on this hub: topic (when the course has topics), unit, review (when it has review notes).
const views = [...(topics ? ["topic"] : []), "unit", ...(reviewGroups.length ? ["review"] : [])];
const multiView = views.length > 1;

const S = {
  "en-US": { ready: "Available", other: "Other language only", open: "Open →", openOther: "Open other lang →", byTopic: "By topic", byUnit: byWeek ? "By week" : "By lecture", byReview: "Review", topicNote: "Topic note", view: "View", topicsNav: "Topics", notes: (n: number) => `${n} note${n === 1 ? "" : "s"}` },
  "zh-CN": { ready: "已就绪", other: "仅另一语言可用", open: "打开 →", openOther: "打开现有版本 →", byTopic: "按话题", byUnit: byWeek ? "按周" : "按讲", byReview: "复习", topicNote: "话题笔记", view: "视图", topicsNav: "话题", notes: (n: number) => `${n} 篇` },
} satisfies Record<Lang, unknown>;

function card(group: (typeof groups)[number], lang: Lang) {
  const own = group.versions[lang];
  const shownLang = own ? lang : otherLang(lang);
  const note = (own ?? group.versions[shownLang])!;
  return {
    label: unitLabel(group, "en-US"),
    title: note.data.title,
    summary: note.data.summary,
    date: formatLastModified(lastModified(note.filePath!), lang),
    href: noteUrl(group.courseSlug, group.slug, shownLang),
    own: !!own,
    shownLang,
  };
}

function topicCard(entry: TopicEntry, lang: Lang) {
  const base = card(entry.group, lang);
  const sections = (entry.sections[base.shownLang] ?? []).map((s) => ({ ...s, href: `${base.href}#${encodeURIComponent(s.id)}` }));
  return { ...base, sections, href: entry.group.kind === "topic" ? base.href : (sections[0]?.href ?? base.href) };
}

---

<BaseLayout title={`${c.name} Notes`} description={`${unitWord} notes for UC Irvine ${c.name} (${c.fullTitle}). Bilingual EN / 中文.`} navPath="notes/">
  <LangBoot slot="head" />
  {multiView && (
    <script is:inline slot="head" define:vars={{ views }}>
      (function () {
        // A #topic-<id> link always opens the topic view, then ?view=, then the saved choice.
        var v = /^#topic-/.test(location.hash) ? "topic" : new URLSearchParams(location.search).get("view");
        if (views.indexOf(v) < 0) {
          try { v = localStorage.getItem("kzh-hub-view"); } catch (e) {}
        }
        document.documentElement.setAttribute("data-hub-view", views.indexOf(v) < 0 ? views[0] : v);
      })();
    </script>
  )}
  <main class="page course-hub-page">
    <div class="page-head card course-hero-head">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={url("notes/")} class="crumb">Notes</a>
          <span class="crumb-sep">›</span>
          <span class="crumb crumb-current">{c.name}</span>
        </nav>
        <h1 class="page-title">{c.name}</h1>
        {LANGS.map((l) => (
          <div data-pane={l} lang={l}>
            <p class="page-sub">{c.copy[l].heroPrimary}</p>
            <p class="page-sub" style="margin-top:10px;">{c.copy[l].heroSecondary}</p>
          </div>
        ))}
      </div>
      <LangSwitch />
    </div>

    {multiView && (
      <div class="card hub-toolbar">
        {LANGS.map((l) => (
          <div class="lang-switch view-switch" role="group" aria-label={S[l].view} data-pane={l} lang={l}>
            {topics && <button type="button" data-hub-view-btn="topic">{S[l].byTopic}</button>}
            <button type="button" data-hub-view-btn="unit">{S[l].byUnit}</button>
            {reviewGroups.length > 0 && <button type="button" data-hub-view-btn="review">{S[l].byReview}</button>}
          </div>
        ))}
        {topics && LANGS.map((l) => (
          <nav class="topic-chips" aria-label={S[l].topicsNav} data-pane={l} lang={l} data-view="topic">
            {topics.map((t) => (
              <a class="topic-chip" href={`#topic-${t.id}`}>{t.label[l]}{t.entries.length > 1 && <span class="topic-chip-n">{t.entries.length}</span>}</a>
            ))}
          </nav>
        ))}
      </div>
    )}

    {topics && (
      <div class="topic-list" data-view="topic">
        {topics.map((t) => (
          <section class="topic-section" id={`topic-${t.id}`}>
            {LANGS.map((l) => (
              <div data-pane={l} lang={l}>
                <header class="topic-head">
                  <h2>{t.label[l]}</h2>
                  {t.entries.length > 1 && <span class="topic-count">{S[l].notes(t.entries.length)}</span>}
                </header>
                {t.summary && <p class="topic-summary">{t.summary[l]}</p>}
                <div class="week-grid">
                  {t.entries.map((e) => ({ e, n: topicCard(e, l) })).map(({ e, n }) => (
                    <article class={e.group.kind === "topic" ? "card week-card topic-note-card" : "card week-card"}>
                      <span class="week-badge">{e.group.kind === "topic" ? S[l].topicNote : n.label}</span>
                      <h3>{n.title}</h3>
                      {n.sections.length ? (
                        <ul class="topic-sections">
                          {n.sections.map((s) => <li class={s.depth === 3 ? "sub" : undefined}><a href={s.href}>{s.text}</a></li>)}
                        </ul>
                      ) : (
                        <p class="week-summary">{n.summary}</p>
                      )}
                      <p class="week-date">{n.date}</p>
                      <div class="week-meta-row">
                        <span class={n.own ? "note-state ready" : "note-state"}>{n.own ? S[l].ready : S[l].other}</span>
                        <a href={n.href} class="btn-open">{n.own ? S[l].open : S[l].openOther}</a>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            ))}
          </section>
        ))}
      </div>
    )}

    {LANGS.map((l) => (
      <div class="week-grid" data-pane={l} lang={l} data-view="unit">
        {unitGroups.map((g) => card(g, l)).map((n) => (
          <article class="card week-card">
            <span class="week-badge">{n.label}</span>
            <h3>{n.title}</h3>
            <p class="week-summary">{n.summary}</p>
            <p class="week-date">{n.date}</p>
            <div class="week-meta-row">
              <span class={n.own ? "note-state ready" : "note-state"}>{n.own ? S[l].ready : S[l].other}</span>
              <a href={n.href} class="btn-open">{n.own ? S[l].open : S[l].openOther}</a>
            </div>
          </article>
        ))}
      </div>
    ))}

    {reviewGroups.length > 0 && LANGS.map((l) => (
      <div class="week-grid" data-pane={l} lang={l} data-view="review">
        {reviewGroups.map((g) => card(g, l)).map((n) => (
          <article class="card week-card">
            <span class="week-badge">{n.label}</span>
            <h3>{n.title}</h3>
            <p class="week-summary">{n.summary}</p>
            <p class="week-date">{n.date}</p>
            <div class="week-meta-row">
              <span class={n.own ? "note-state ready" : "note-state"}>{n.own ? S[l].ready : S[l].other}</span>
              <a href={n.href} class="btn-open">{n.own ? S[l].open : S[l].openOther}</a>
            </div>
          </article>
        ))}
      </div>
    ))}
  </main>
</BaseLayout>

<script>
  const KEY = "kzh-hub-view";
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-hub-view-btn]");
  function sync() {
    buttons.forEach((b) => {
      const on = b.dataset["hubViewBtn"] === root.dataset["hubView"];
      b.classList.toggle("active", on);
      b.setAttribute("aria-pressed", String(on));
    });
  }
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const view = b.dataset["hubViewBtn"] ?? "unit";
      root.dataset["hubView"] = view;
      try { localStorage.setItem(KEY, view); } catch {}
      const u = new URL(location.href);
      u.searchParams.set("view", view);
      if (view !== "topic" && u.hash.startsWith("#topic-")) u.hash = "";
      history.replaceState(null, "", u);
      sync();
    }),
  );
  sync();
</script>

<style>
  :global(html[data-hub-view="topic"]) [data-view]:not([data-view="topic"]),
  :global(html[data-hub-view="unit"]) [data-view]:not([data-view="unit"]),
  :global(html[data-hub-view="review"]) [data-view]:not([data-view="review"]) {
    display: none !important;
  }
  .hub-toolbar {
    display: flex; align-items: center; gap: 12px 16px; flex-wrap: wrap;
    padding: 12px 14px;
  }
  .topic-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .topic-chip {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: var(--r-pill);
    background: var(--card-2); color: var(--ink-2);
    font-size: 12px; font-weight: 600;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .topic-chip:hover { color: var(--ink); }
  .topic-chip-n { font-size: 11px; color: var(--subtle); font-weight: 600; }
  .topic-list { display: flex; flex-direction: column; gap: 28px; }
  .topic-section { scroll-margin-top: 90px; }
  .topic-head { display: flex; align-items: baseline; gap: 10px; margin: 6px 4px 4px; }
  .topic-head h2 { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.4px; }
  .topic-count { font-size: 12px; color: var(--subtle); font-weight: 600; }
  .topic-summary { margin: 0 4px 12px; font-size: 13px; line-height: 1.55; color: var(--ink-2); }
  .topic-head + .week-grid { margin-top: 12px; }
  .topic-note-card { border: 1.5px solid var(--uci-gold, #ffd200); }
  .topic-sections {
    margin: 0; padding: 0; list-style: none;
    display: flex; flex-direction: column; gap: 4px;
    font-size: 13px; line-height: 1.45;
  }
  .topic-sections a { color: var(--ink-2); }
  .topic-sections .sub { padding-left: 14px; font-size: 12.5px; }
  .topic-sections .sub a { color: var(--subtle); }
  .topic-sections a:hover { color: var(--uci-blue); text-decoration: underline; }
  :global(html[data-theme="dark"]) .topic-sections a:hover { color: #58a6ff; }
</style>
